# Env-Vars für Vercel (niemals echte Werte committen)

RESEND_API_KEY=re_xxx
CONTACT_TO=marcosakreida@outlook.de
CONTACT_FROM=kontakt@sakreida.digital

# Notion-Anbindung (Backoffice + Lead-Erfassung)
# Gleicher Token wie die lokale Integration "opencode"
NOTION_TOKEN=ntn_xxx

# Backoffice-Login (sakreida.digital/admin)
ADMIN_PASSWORD=langes-zufaelliges-passwort
# Optional: eigener Signatur-Schlüssel (sonst wird ADMIN_PASSWORD verwendet)
ADMIN_SECRET=zufaelliger-secret-string
